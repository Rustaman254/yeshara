# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production is the committed default for NEXT_PUBLIC_API_URL on a
# real deploy — not a secret, just the backend's public URL. .env.local
# (still ignored, machine-local only) overrides it for local dev.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
